local function getInfo(inst)
	local i = info[inst]
	if i then return i end
	local nm, cls = "?", "?"
	pcall(function()
		nm = inst.Name
		cls = inst.ClassName
	end)
	local ok, f = pcall(inst.GetFullName, inst)
	i = { nm = nm, cls = cls, full = clean(ok and f or nm) }
	info[inst] = i
	return i
end

local function takeToken(now)
	X.tokens = X.tokens + (now - X.tokT) * K.BUCKET_RATE
	if X.tokens > K.BUCKET_MAX then X.tokens = K.BUCKET_MAX end
	X.tokT = now
	if X.tokens >= 1 then
		X.tokens = X.tokens - 1
		return true
	end
	return false
end

local function newRec(dir, remote, method, args, now, ex, caller)
	N.seq = N.seq + 1
	local idx = (N.seq - 1) % K.LOGCAP + 1
	local old = logs[idx]
	if old then old.live = false end
	local rec = {
		i = N.seq, t = r2(now - T0), t0 = now, d = dir, r = remote, m = method,
		n = 1, a = args, live = true, ex = ex, c = caller,
	}
	logs[idx] = rec
	N.logged = N.logged + 1
	X.dirty = true
	return rec
end

local function enqueue(e)
	if qt - qh >= QCAP then
		N.dropQ = N.dropQ + 1
		return nil
	end
	qt = qt + 1
	q[qt % QCAP + 1] = e
	return e
end

do
	local function srcKey(src)
		local n = #src
		local h = n
		local byte = string.byte
		for i = 1, math.min(n, 256) do
			h = (h * 31 + byte(src, i)) % 2147483647
		end
		if n > 512 then
			local m = floor(n / 2)
			for i = m, math.min(n, m + 127) do
				h = (h * 31 + byte(src, i)) % 2147483647
			end
		end
		if n > 256 then
			for i = math.max(1, n - 127), n do
				h = (h * 31 + byte(src, i)) % 2147483647
			end
		end
		return h .. ":" .. n
	end

	function D.looks(body, url)
		if #body < 24 then return false end
		local c = body:sub(1, 1)
		if c == "{" or c == "[" or c == "<" then return false end
		if url and url:lower():find("%.lua") then return true end
		local head = body:sub(1, 4000)
		if head:find("local ", 1, true) or head:find("function", 1, true) or head:find("game", 1, true)
			or head:find("loadstring", 1, true) or head:find("return", 1, true) or head:find("--", 1, true) then
			return true
		end
		return false
	end

	function D.queue(src, tag, url)
		if not S.dump or not HAS_W then return nil end
		local n = #src
		if n < 16 then return nil end
		local key = srcKey(src)
		local ex = D.seen[key]
		if ex then return ex end
		if D.n >= K.DUMP_MAX then
			D.skipped = D.skipped + 1
			return nil
		end
		if n > K.DUMP_FILE_MAX or D.pending + n > K.DUMP_PEND_MAX then
			D.skipped = D.skipped + 1
			return nil
		end
		D.n = D.n + 1
		local safeTag = tag:gsub("[^%w]", "")
		local fname = string.format("%s_%03d_%s.lua", PATH.tag, D.n, safeTag)
		D.seen[key] = fname
		D.t = D.t + 1
		D.q[D.t] = { f = fname, s = src }
		D.pending = D.pending + n
		D.list[#D.list + 1] = { f = fname, tag = tag, bytes = n, url = url }
		return fname
	end

	function D.writeOne()
		if D.h > D.t then return false end
		local it = D.q[D.h]
		D.q[D.h] = nil
		D.h = D.h + 1
		D.pending = D.pending - #it.s
		if not pcall(writefile, PATH.d(it.f), it.s) then
			D.fail = D.fail + 1
		end
		return true
	end
end

do
	local INTEREST = {
		FireServer = 1, InvokeServer = 2,
		Kick = 3, Shutdown = 3, Teleport = 3, TeleportToPlaceInstance = 3, TeleportAsync = 3,
		TeleportToSpawnByName = 3, TeleportPartyAsync = 3, TeleportToPrivateServer = 3,
		HttpGet = 4, HttpGetAsync = 4, HttpPost = 4, HttpPostAsync = 4,
	}

	function F.sysReason(m)
		if m == "Kick" then return "kick" end
		if m == "Shutdown" then return "shutdown" end
		return "teleport"
	end

	function F.capCall(self, m, ex, ...)
		lastNcSelf = self
		lastNcT = clock()
		local mu = mutedC[self]
		if mu then
			local c = mu.c + 1
			mu.c = c
			if c % mu.every ~= 0 then return nil end
		end
		local sc = nil
		if not ex then sc = getCS() end
		return enqueue({ k = 1, d = "C2S", s = self, m = m, a = pack(...), t = clock(), sc = sc, ex = ex })
	end

	function F.capSys(self, m, ...)
		enqueue({ k = 4, s = self, m = m, a = pack(...), t = clock() })
	end

	function F.capNet(tag, url, meth, res)
		local body, status
		if type(res) == "table" then
			body = res.Body or res.body
			status = res.StatusCode or res.status_code or res.Status
		elseif type(res) == "string" then
			body = res
		end
		enqueue({ k = 3, tag = tag, u = url, mth = meth, b = body, st = status, t = clock() })
	end

	function F.capSrc(tag, src)
		enqueue({ k = 7, tag = tag, src = src, t = clock() })
	end

	local capCall, capSys, capNet, sysReason = F.capCall, F.capSys, F.capNet, F.sysReason

	function F.ncHook(self, ...)
		local m = getnm()
		local kind = INTEREST[m]
		if kind == nil or busy or not alive then
			return oldNc(self, ...)
		end
		if kind == 1 then
			if S.nc and MOD.nc then
				local ok = pcall(capCall, self, m, ckc(), ...)
				if not ok then fault("nc") end
			end
			setnm(m)
			return oldNc(self, ...)
		elseif kind == 2 then
			if S.nc and MOD.nc then
				local ok, ent = pcall(capCall, self, m, ckc(), ...)
				if ok and ent then
					setnm(m)
					local r = pack(oldNc(self, ...))
					enqueue({ k = 2, r = ent, v = r })
					return unpack(r, 1, r.n)
				elseif not ok then
					fault("nc")
				end
			end
			setnm(m)
			return oldNc(self, ...)
		elseif kind == 3 then
			pcall(capSys, self, m, ...)
			if m ~= "Kick" or self == LP then
				pcall(saveNow, sysReason(m))
			end
			X.sysM = m
			X.sysT = clock()
			setnm(m)
			return oldNc(self, ...)
		else
			if (MOD.net or MOD.http) and self == game then
				local a1 = ...
				X.httpUrl = a1
				setnm(m)
				local r = pack(oldNc(self, ...))
				X.httpUrl = nil
				pcall(capNet, m, a1, nil, r[1])
				return unpack(r, 1, r.n)
			end
			setnm(m)
			return oldNc(self, ...)
		end
	end
end

do
	local function muteRemote(inst, st, dir, rate, why, now)
		local ttl = 5 * (2 ^ math.min(st.mutes, 3))
		st.mutes = st.mutes + 1
		local every = st.nsig >= 8 and 25 or 80
		local mu = {
			key = inst, st = st, dir = dir, every = every, c = 0, lc = 0,
			t0 = now, exp = now + ttl, why = why, peak = rate, sup = 0,
		}
		if dir == "S2C" then mutedS[inst] = mu else mutedC[inst] = mu end
		st.mu = mu
		muteList[#muteList + 1] = mu
		newRec("SPM", st.full, "mute", {
			why, string.format("%.0f/s", rate), "ttl " .. ttl .. "s", "1/" .. every,
		}, now)
	end

	function F.releaseMute(mu, idx, now, rate)
		if mu.dir == "S2C" then mutedS[mu.key] = nil else mutedC[mu.key] = nil end
		mu.st.mu = nil
		mu.st.ema = rate
		table.remove(muteList, idx)
		newRec("SPM", mu.st.full, "unmute", {
			"suppressed " .. mu.sup, "dur " .. floor(now - mu.t0) .. "s", "peak " .. floor(mu.peak) .. "/s",
		}, now)
	end

	local function emit(st, e, strs, n, sig, now, mode)
		local rec = st.rec
		if (mode == "merge" or mode == "sample") and rec and rec.live and rec.sg == sig and now - rec.t0 < WIN then
			rec.n = rec.n + 1
			rec.tl = r2(now - T0)
			st.merged = st.merged + 1
			N.merged = N.merged + 1
			X.dirty = true
			return
		end
		if mode == "sample" then
			st.sc = st.sc + 1
			if st.sc % 6 ~= 0 then
				N.sampled = N.sampled + 1
				st.smp = st.smp + 1
				return
			end
		end
		if not takeToken(now) then
			N.bucket = N.bucket + 1
			return
		end
		local cname = nil
		if e.sc then
			local ok, v = pcall(function() return e.sc.Name end)
			if ok then cname = clean(tostring(v)) end
		end
		local rec2 = newRec(st.dir, st.full, e.m, strs, now, e.ex, cname)
		rec2.sg = sig
		st.rec = rec2
		st.logged = st.logged + 1
		e.rec = rec2
	end

	local function handleCall(e, now)
		local inst = e.s
		if typeof(inst) ~= "Instance" then return end
		local dir = e.d
		local reg = dir == "S2C" and stS or stC
		local st = reg[inst]
		if not st then
			local i = getInfo(inst)
			if dir == "C2S" then
				local c = i.cls
				if e.m == "FireServer" then
					if c ~= "RemoteEvent" and c ~= "UnreliableRemoteEvent" then return end
				elseif c ~= "RemoteFunction" then
					return
				end
			end
			st = {
				nm = i.nm, full = i.full, dir = dir, m = e.m,
				n = 0, wc = 0, ws = now, ema = 0, peak = 0, lt = now, mi = 0, md = 0,
				rep = 0, ls = "", win = {}, nsig = 0, seen = {}, nseen = 0,
				logged = 0, merged = 0, smp = 0, sc = 0, supp = 0, mutes = 0, ret = false,
			}
			reg[inst] = st
			N.remotes = N.remotes + 1
		end
		e.st = st
		N.total = N.total + 1
		st.n = st.n + 1
		st.wc = st.wc + 1
		if not st.act then
			st.act = true
			act[#act + 1] = st
		end
		local dt = now - st.lt
		st.lt = now
		if st.n > 2 and dt >= 0 and dt < 3 then
			st.mi = st.mi * 0.8 + dt * 0.2
			st.md = st.md * 0.8 + math.abs(dt - st.mi) * 0.2
		end
		local strs, n = packStr(e.a, 4)
		e.a = nil
		local sig = n .. "\31" .. table.concat(strs, "\31", 1, math.min(#strs, 3))
		if sig == st.ls then
			st.rep = st.rep + 1
		else
			st.rep = 0
			st.ls = sig
		end
		if not st.win[sig] and st.nsig < 16 then
			st.win[sig] = true
			st.nsig = st.nsig + 1
		end
		local isNew = false
		if not st.seen[sig] and st.nseen < 24 then
			st.seen[sig] = true
			st.nseen = st.nseen + 1
			isNew = true
		end
		if st.mu then
			emit(st, e, strs, n, sig, now, "smp")
			return
		end
		local el = now - st.ws
		if el < 0.25 then el = 0.25 end
		local rate = st.wc / el
		if st.ema > rate then rate = st.ema end
		if rate > st.peak then st.peak = rate end
		local periodic = st.n >= 10 and st.mi > 0 and (st.md / st.mi) < 0.3
		local protected = rate < 10 or (st.ret and rate < 30)
		if not protected then
			local flood = rate >= 70
			local loop = rate >= 20 and st.rep >= 5 and (periodic or st.rep >= 12)
			if flood or loop then
				emit(st, e, strs, n, sig, now, "all")
				muteRemote(inst, st, dir, rate, loop and "loop" or "flood", now)
				return
			end
		end
		local mode
		if rate < 6 or isNew then
			mode = "all"
		elseif rate < 20 then
			mode = "merge"
		else
			mode = "sample"
		end
		emit(st, e, strs, n, sig, now, mode)
	end

	local function handleRet(e)
		local ent = e.r
		if not ent then return end
		if ent.st then ent.st.ret = true end
		local rec = ent.rec
		if rec and rec.live then
			rec.ret = packStr(e.v, 3)
		end
	end

	local function handleNet(e, now)
		armFlag(now)
		local url = e.u
		local us = type(url) == "string" and url or tostring(url)
		us = clean(us:sub(1, 200))
		local body = e.b
		local blen, head = 0, ""
		local file = nil
		if type(body) == "string" then
			blen = #body
			head = clean(body:sub(1, 120))
			if S.dump and D.looks(body, us) then
				file = D.queue(body, e.tag, us)
			end
		end
		local key = e.tag .. "|" .. us
		local rec = X.netRecs[key]
		if rec and rec.live and now - rec.t0 < WIN then
			rec.n = rec.n + 1
			N.merged = N.merged + 1
			return
		end
		if not takeToken(now) then
			N.bucket = N.bucket + 1
			return
		end
		local a = { us }
		if e.mth then a[#a + 1] = clean(tostring(e.mth)) end
		if e.st then a[#a + 1] = "st=" .. clean(tostring(e.st)) end
		a[#a + 1] = blen .. "b"
		if head ~= "" then a[#a + 1] = head end
		if file then a[#a + 1] = "-> " .. file end
		rec = newRec("NET", us, e.tag, a, now)
		rec.f = file
		X.netRecs[key] = rec
		N.netCount = N.netCount + 1
		if N.netCount > 300 then
			X.netRecs = {}
			N.netCount = 0
		end
	end

	local function handleSrc(e, now)
		local src = e.src
		if type(src) ~= "string" then src = tostring(src) end
		local tag = e.tag
		local isLS = tag == "loadstring"
		if isLS then armFlag(now) end
		local file = nil
		if tag ~= "setclipboard" then
			file = D.queue(src, tag, nil)
		end
		local head = clean(src:sub(1, 120))
		local key = tag .. "|" .. #src .. "|" .. head:sub(1, 40)
		local rec = X.srcRecs[key]
		if rec and rec.live and now - rec.t0 < WIN * 5 then
			rec.n = rec.n + 1
			N.merged = N.merged + 1
			return
		end
		if not takeToken(now) then
			N.bucket = N.bucket + 1
			return
		end
		local a = { #src .. "b", head }
		if file then a[#a + 1] = "-> " .. file end
		rec = newRec(isLS and "LS" or "SYS", tag, tag, a, now)
		rec.f = file
		X.srcRecs[key] = rec
		N.srcCount = N.srcCount + 1
		if N.srcCount > 300 then
			X.srcRecs = {}
			N.srcCount = 0
		end
	end

	local function handleSys(e, now)
		local nm = "?"
		if typeof(e.s) == "Instance" then nm = getInfo(e.s).nm end
		local strs = packStr(e.a, 3)
		newRec("SYS", nm, e.m, strs, now)
	end

	handle = function(e, now)
		local k = e.k
		if k == 1 then
			handleCall(e, e.t or now)
		elseif k == 2 then
			handleRet(e)
		elseif k == 3 then
			handleNet(e, e.t or now)
		elseif k == 4 then
			handleSys(e, e.t or now)
		elseif k == 7 then
			handleSrc(e, e.t or now)
		end
	end

	function F.process(budget)
		local t1 = clock()
		local n = 0
		while qh < qt do
			qh = qh + 1
			local idx = qh % QCAP + 1
			local e = q[idx]
			q[idx] = nil
			if e then handle(e, t1) end
			n = n + 1
			if n % 16 == 0 and clock() - t1 > budget then break end
		end
	end
end

do
	local function fmt(n)
		if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
		if n >= 1000 then return string.format("%.1fk", n / 1000) end
		return tostring(n)
	end
	F.fmt = fmt

	local wrapCb

	function F.trackRF(rf)
		if RF.seen[rf] or #RF.list >= K.RF_CAP then return end
		local ok, u = pcall(rf.IsDescendantOf, rf, SV.CoreGui)
		if ok and u then return end
		RF.seen[rf] = true
		RF.list[#RF.list + 1] = rf
		if MOD.cb then
			task.delay(0.5, function()
				if alive and MOD.cb then pcall(wrapCb, rf) end
			end)
		end
	end

	wrapCb = function(rf)
		if type(getcallbackvalue) ~= "function" then return end
		local ok, cb = pcall(getcallbackvalue, rf, "OnClientInvoke")
		if not ok or type(cb) ~= "function" then return end
		if RF.isW[cb] or RF.wrap[rf] == cb then return end
		local cnt = RF.count[rf] or 0
		if cnt >= 4 then return end
		local w = function(...)
			if MOD.cb and alive and not busy then
				enqueue({ k = 1, d = "S2C", s = rf, m = "OnClientInvoke", a = pack(...), t = clock() })
			end
			return cb(...)
		end
		if pcall(function() rf.OnClientInvoke = w end) then
			RF.isW[w] = true
			RF.wrap[rf] = w
			RF.count[rf] = cnt + 1
			RF.n = RF.n + 1
		end
	end
	F.wrapCb = wrapCb

	function F.tick(now)
		local dt = now - X.lastTick
		if dt < 0.5 then dt = 0.5 end
		X.lastTick = now
		local nl = {}
		for i = 1, #act do
			local st = act[i]
			local el = now - st.ws
			if el < 0.5 then el = 0.5 end
			st.ema = st.ema * 0.5 + (st.wc / el) * 0.5
			st.wc = 0
			st.ws = now
			st.win = {}
			st.nsig = 0
			if st.ema > 0.3 or st.mu then
				nl[#nl + 1] = st
			else
				st.act = false
				st.ema = 0
			end
		end
		act = nl
		for i = #muteList, 1, -1 do
			local mu = muteList[i]
			local c = mu.c
			local dc = c - mu.lc
			mu.lc = c
			local pushedNow = floor(c / mu.every) - floor((c - dc) / mu.every)
			local sk = dc - pushedNow
			if sk < 0 then sk = 0 end
			N.total = N.total + sk
			N.supp = N.supp + sk
			mu.st.supp = mu.st.supp + sk
			mu.sup = mu.sup + sk
			local rate = dc / dt
			if rate > mu.peak then mu.peak = rate end
			if now >= mu.exp then
				if rate < 15 then
					F.releaseMute(mu, i, now, rate)
				else
					mu.exp = now + 3
				end
			end
		end
		if X.flagUntil > 0 and now > X.flagUntil then
			FS.del(PATH.flag)
			X.flagUntil = 0
		end
		if MOD.cb and now - X.lastRf >= 8 then
			X.lastRf = now
			for i = 1, #RF.list do
				pcall(wrapCb, RF.list[i])
			end
		end
		local okm, mb = pcall(function() return SV.Stats:GetTotalMemoryUsageMb() end)
		if okm and type(mb) == "number" then
			local mem = X.mem
			mem[#mem + 1] = mb
			if #mem > 10 then table.remove(mem, 1) end
			if (mb > K.MEM_ABS or mb - mem[1] > K.MEM_GROW) and now - X.lastMem > 30 then
				X.lastMem = now
				task.defer(saveNow, "memory")
			end
		end
		if X.stall then
			X.stall = false
			task.defer(saveNow, "stall")
		end
		uiCount()
	end

	local function collectRecs()
		local out = {}
		local first = N.seq - K.LOGCAP + 1
		if first < 1 then first = 1 end
		for s = first, N.seq do
			local r = logs[(s - 1) % K.LOGCAP + 1]
			if r and r.i == s then out[#out + 1] = r end
		end
		return out
	end

	local function remList()
		local out = {}
		local function add(reg)
			for _, st in pairs(reg) do
				out[#out + 1] = {
					d = st.dir, r = st.full, m = st.m, calls = st.n + st.supp, logged = st.logged,
					merged = st.merged, sampled = st.smp, suppressed = st.supp, mutes = st.mutes,
					peak = r2(st.peak), ret = st.ret or nil, muted = st.mu and true or nil,
				}
			end
		end
		add(stC)
		add(stS)
		table.sort(out, function(a, b) return a.calls > b.calls end)
		for i = #out, 101, -1 do out[i] = nil end
		return out
	end

	local function enc(t)
		local ok, js = pcall(SV.HttpService.JSONEncode, SV.HttpService, t)
		if ok then return js end
		return nil
	end
	F.enc = enc

	local function recOut(r)
		return {
			i = r.i, t = r.t, tl = r.tl, d = r.d, n = r.n, r = r.r, m = r.m,
			c = r.c, x = r.ex and true or nil, a = r.a, ret = r.ret, f = r.f,
		}
	end

	function F.stats()
		return {
			total = N.total, logged = N.logged, merged = N.merged, sampled = N.sampled,
			suppressed = N.supp, bucketDropped = N.bucket, queueDropped = N.dropQ,
			errors = N.err, remotes = N.remotes, muted = #muteList, dumps = D.n,
			hooks = {
				nc = INST.nc, fn = INST.fn, s2c = INST.s2c, cb = INST.cb,
				sys = INST.sys, net = INST.net, http = INST.http, ls = INST.ls,
			},
		}
	end

	local function buildJSON(reason)
		local recs = collectRecs()
		local exec = "unknown"
		pcall(function()
			if identifyexecutor then
				local n, v = identifyexecutor()
				exec = tostring(n) .. (v and (" " .. tostring(v)) or "")
			end
		end)
		local meta = {
			tool = "Aluz Spy", version = VERSION, schema = 3, executor = exec,
			place = game.PlaceId, job = game.JobId, exported = os.date("%Y-%m-%d %H:%M:%S"),
			reason = reason, session_file = PATH.session,
			uptime = r2(clock() - T0), safe_boot = BAN.safe, banned = BAN.list,
			hooks = {
				namecall = INST.nc, namecall_on = S.nc and MOD.nc, direct = INST.fn and MOD.fn,
				s2c = INST.s2c and MOD.s2c, callbacks = INST.cb and MOD.cb, sys = INST.sys and MOD.sys,
				net = INST.net and MOD.net, http = INST.http and MOD.http, loadstring = INST.ls and MOD.ls,
			},
			stats = {
				total = N.total, logged = N.logged, merged = N.merged, sampled_out = N.sampled,
				suppressed = N.supp, bucket_dropped = N.bucket, queue_dropped = N.dropQ,
				errors = N.err, remotes = N.remotes, muted_now = #muteList, attached = N.att,
				callbacks_wrapped = RF.n, entries = #recs,
			},
			dump = {
				enabled = S.dump, files = D.n, pending = D.t - D.h + 1, skipped = D.skipped,
				failed = D.fail, folder = PATH.ok and PATH.dumpDir or "root", list = D.list,
			},
			last_errors = errMap,
		}
		local head = '{"schema":3,"meta":' .. (enc(meta) or "{}") .. ',"remotes":' .. (enc(remList()) or "[]") .. ',"logs":['
		local lines = {}
		for i = 1, #recs do
			local js = enc(recOut(recs[i]))
			if js then lines[#lines + 1] = js end
		end
		return head .. "\n" .. table.concat(lines, ",\n") .. "\n]}"
	end

	saveNow = function(reason)
		if not HAS_W then return false, "no writefile" end
		local manual = reason == "manual"
		if not manual then
			local now = clock()
			if now - X.lastAuto < 2.5 then return true, "skip" end
			X.lastAuto = now
		end
		local prev = busy
		busy = true
		local ok, res = pcall(function()
			F.process(0.05)
			while D.writeOne() do end
			if not manual and not X.dirty then return "clean" end
			local body = buildJSON(reason)
			writefile(PATH.session, body)
			if manual and type(setclipboard) == "function" and #body < 1500000 then
				pcall(setclipboard, body)
			end
			X.dirty = false
			X.reason = reason
			return PATH.session
		end)
		busy = prev
		if ok then return true, res end
		noteErr(res)
		return false, tostring(res)
	end
end

do
	local function hookWith(fn, make, useNc)
		if type(fn) ~= "function" or seenFn[fn] or not hookfunction then return false end
		seenFn[fn] = true
		local holder = {}
		if clonefunction then
			local okc, c = pcall(clonefunction, fn)
			if okc and type(c) == "function" then holder.old = c end
		end
		local h = make(holder)
		if useNc then h = nc(h) end
		local ok, o = pcall(hookfunction, fn, h)
		if not ok then return false end
		if type(o) == "function" then holder.old = o end
		return holder.old ~= nil
	end

	local capCall, capSys, capNet, capSrc, sysReason = F.capCall, F.capSys, F.capNet, F.capSrc, F.sysReason

	local function makeFire(holder)
		return function(self, ...)
			if MOD.fn and S.nc and alive and not busy
				and not (lastNcSelf == self and clock() - lastNcT < 0.004) then
				local ok = pcall(capCall, self, "FireServer", ckc(), ...)
				if not ok then fault("fn") end
			end
			return holder.old(self, ...)
		end
	end

	local function makeInvoke(holder)
		return function(self, ...)
			if MOD.fn and S.nc and alive and not busy
				and not (lastNcSelf == self and clock() - lastNcT < 0.004) then
				local ok, ent = pcall(capCall, self, "InvokeServer", ckc(), ...)
				if ok and ent then
					local r = pack(holder.old(self, ...))
					enqueue({ k = 2, r = ent, v = r })
					return unpack(r, 1, r.n)
				elseif not ok then
					fault("fn")
				end
			end
			return holder.old(self, ...)
		end
	end

	IN.nc = function()
		if INST.nc then
			MOD.nc = true
			return true
		end
		if not (hookmetamethod and getnm) then return false end
		touchFlag("nc", 30)
		local ok, old = pcall(hookmetamethod, game, "__namecall", nc(F.ncHook))
		if ok and type(old) == "function" then
			oldNc = old
			INST.nc = true
			MOD.nc = true
			return true
		end
		return false
	end

	IN.fn = function()
		if INST.fn then
			MOD.fn = true
			return true
		end
		if not hookfunction then return false end
		touchFlag("fn", 30)
		local any = false
		local function try(cls, method, make, useNc)
			local ok, inst = pcall(Instance.new, cls)
			if not ok or typeof(inst) ~= "Instance" then return end
			local okf, fn = pcall(function() return inst[method] end)
			pcall(inst.Destroy, inst)
			if okf and hookWith(fn, make, useNc) then any = true end
		end
		try("RemoteEvent", "FireServer", makeFire, true)
		try("UnreliableRemoteEvent", "FireServer", makeFire, true)
		try("RemoteFunction", "InvokeServer", makeInvoke, false)
		if any then
			INST.fn = true
			MOD.fn = true
		end
		return any
	end

	local function attach(r)
		if attached[r] ~= nil or N.att >= K.ATT_CAP then return end
		local ok, u = pcall(r.IsDescendantOf, r, SV.CoreGui)
		if ok and u then
			attached[r] = false
			return
		end
		local okc, conn = pcall(function()
			return r.OnClientEvent:Connect(function(...)
				if not (MOD.s2c and alive) then return end
				local mu = mutedS[r]
				if mu then
					local c = mu.c + 1
					mu.c = c
					if c % mu.every ~= 0 then return end
				end
				enqueue({ k = 1, d = "S2C", s = r, m = "OnClientEvent", a = pack(...), t = clock() })
			end)
		end)
		if not okc or not conn then return end
		attached[r] = conn
		N.att = N.att + 1
		pcall(function()
			local dconn
			dconn = r.Destroying:Connect(function()
				pcall(conn.Disconnect, conn)
				pcall(dconn.Disconnect, dconn)
				if attached[r] then
					attached[r] = nil
					N.att = N.att - 1
				end
			end)
		end)
	end

	IN.s2c = function()
		if INST.s2c then
			MOD.s2c = true
			return true
		end
		INST.s2c = true
		MOD.s2c = true
		conns[#conns + 1] = game.DescendantAdded:Connect(function(d)
			local cn = d.ClassName
			if cn == "RemoteEvent" or cn == "UnreliableRemoteEvent" then
				attach(d)
			elseif cn == "RemoteFunction" then
				F.trackRF(d)
			end
		end)
		task.spawn(function()
			task.wait(0.5)
			pcall(function()
				local list = game:GetDescendants()
				for i = 1, #list do
					if not alive then return end
					local inst = list[i]
					local cn = inst.ClassName
					if cn == "RemoteEvent" or cn == "UnreliableRemoteEvent" then
						attach(inst)
					elseif cn == "RemoteFunction" then
						F.trackRF(inst)
					end
					if i % 1500 == 0 then task.wait() end
				end
			end)
		end)
		return true
	end

	IN.cb = function()
		if INST.cb then
			MOD.cb = true
			return true
		end
		if type(getcallbackvalue) ~= "function" then return false end
		INST.cb = true
		MOD.cb = true
		for i = 1, #RF.list do
			pcall(F.wrapCb, RF.list[i])
		end
		return true
	end

	IN.sys = function()
		if INST.sys then
			MOD.sys = true
			return true
		end
		local any = false
		local function wrap(fn, tag)
			local ok = hookWith(fn, function(holder)
				return function(a, ...)
					if MOD.sys and alive and not busy then pcall(capSrc, tag, a) end
					return holder.old(a, ...)
				end
			end, true)
			if ok then any = true end
		end
		wrap(genv.queue_on_teleport, "queue_on_teleport")
		wrap(genv.queueonteleport, "queue_on_teleport")
		if type(genv.syn) == "table" then wrap(genv.syn.queue_on_teleport, "queue_on_teleport") end
		wrap(genv.setclipboard, "setclipboard")
		wrap(genv.toclipboard, "setclipboard")
		wrap(genv.set_clipboard, "setclipboard")
		local function direct(inst, method)
			local okf, fn = pcall(function() return inst[method] end)
			if not okf then return end
			local ok = hookWith(fn, function(holder)
				return function(self, ...)
					if MOD.sys and alive and not busy
						and not (X.sysM == method and clock() - X.sysT < 0.05) then
						pcall(capSys, self, method, ...)
						if method ~= "Kick" or self == LP then
							pcall(saveNow, sysReason(method))
						end
					end
					return holder.old(self, ...)
				end
			end, false)
			if ok then any = true end
		end
		direct(LP, "Kick")
		local okT, ts = pcall(game.GetService, game, "TeleportService")
		if okT and ts then
			local list = { "Teleport", "TeleportToPlaceInstance", "TeleportAsync", "TeleportToSpawnByName", "TeleportPartyAsync", "TeleportToPrivateServer" }
			for i = 1, #list do direct(ts, list[i]) end
		end
		conns[#conns + 1] = SV.GuiService.ErrorMessageChanged:Connect(function(msg)
			if type(msg) == "string" and msg ~= "" then
				local prev = busy
				busy = true
				pcall(newRec, "SYS", "GuiService", "ErrorMessage", { clean(msg:sub(1, 200)) }, clock())
				busy = prev
				pcall(saveNow, "error")
			end
		end)
		conns[#conns + 1] = LP.OnTeleport:Connect(function(state)
			if state == Enum.TeleportState.Started or state == Enum.TeleportState.InProgress then
				pcall(saveNow, "teleport")
			end
		end)
		INST.sys = true
		MOD.sys = true
		return any
	end

	IN.net = function()
		if INST.net then
			MOD.net = true
			return true
		end
		local any = false
		local function hookReq(fn, tag)
			local ok = hookWith(fn, function(holder)
				return function(opts, ...)
					if MOD.net and alive and not busy then
						local url, meth
						if type(opts) == "table" then
							url = opts.Url or opts.url or opts.URL
							meth = opts.Method or opts.method
						elseif type(opts) == "string" then
							url = opts
						end
						local r = pack(holder.old(opts, ...))
						pcall(capNet, tag, url, meth, r[1])
						return unpack(r, 1, r.n)
					end
					return holder.old(opts, ...)
				end
			end, false)
			if ok then any = true end
		end
		hookReq(genv.request, "request")
		hookReq(genv.http_request, "http_request")
		hookReq(genv.httprequest, "httprequest")
		if type(genv.syn) == "table" then hookReq(genv.syn.request, "syn.request") end
		if type(genv.http) == "table" then hookReq(genv.http.request, "http.request") end
		if type(genv.fluxus) == "table" then hookReq(genv.fluxus.request, "fluxus.request") end
		INST.net = true
		MOD.net = true
		return any
	end

	IN.http = function()
		if INST.http then
			MOD.http = true
			return true
		end
		local any = false
		local list = { "HttpGet", "HttpGetAsync" }
		for i = 1, #list do
			local name = list[i]
			local okf, fn = pcall(function() return game[name] end)
			if okf then
				local ok = hookWith(fn, function(holder)
					return function(self, url, ...)
						if MOD.http and alive and not busy and not (X.httpUrl ~= nil and X.httpUrl == url) then
							local r = pack(holder.old(self, url, ...))
							pcall(capNet, name, url, nil, r[1])
							return unpack(r, 1, r.n)
						end
						return holder.old(self, url, ...)
					end
				end, false)
				if ok then any = true end
			end
		end
		INST.http = true
		MOD.http = true
		return any
	end

	IN.ls = function()
		if INST.ls then
			MOD.ls = true
			return true
		end
		local fn = genv.loadstring or loadstring
		local ok = hookWith(fn, function(holder)
			return function(src, ...)
				if MOD.ls and alive and not busy then pcall(capSrc, "loadstring", src) end
				return holder.old(src, ...)
			end
		end, true)
		if not ok then return false end
		INST.ls = true
		MOD.ls = true
		local prev = busy
		busy = true
		local okT, f = pcall(loadstring, "return 41+1")
		busy = prev
		if not (okT and type(f) == "function") then
			MOD.ls = false
			return false
		end
		local okR, v = pcall(f)
		if not okR or v ~= 42 then
			MOD.ls = false
			return false
		end
		return true
	end
end

local okUI, errUI = xpcall(function()
	local function notify(text)
		pcall(function()
			SV.StarterGui:SetCore("SendNotification", { Title = "Aluz Spy", Text = tostring(text), Duration = 3 })
		end)
	end

	local W_OPEN, W_CLOSED, H = 170, 28, 28
	local C_BG = Color3.fromRGB(14, 15, 20)
	local C_ACC = Color3.fromRGB(0, 210, 150)
	local C_NEU_BG = Color3.fromRGB(32, 34, 44)
	local C_TXT = Color3.fromRGB(225, 228, 238)
	local C_ON_BG, C_ON_TX = Color3.fromRGB(22, 78, 52), Color3.fromRGB(110, 255, 170)
	local C_BAD_BG, C_BAD_TX = Color3.fromRGB(86, 32, 32), Color3.fromRGB(255, 130, 130)
	local TI_DOWN = TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local TI_UP = TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local TI_FOLD = TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local TI_COL = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local TS = SV.TweenService
	local UIS = SV.UserInputService
	local RS = SV.RunService

	local function mk(cls, props, parent)
		local o = Instance.new(cls)
		for k, v in pairs(props) do o[k] = v end
		if parent then o.Parent = parent end
		return o
	end

	local gui = mk("ScreenGui", {
		Name = "AluzSpy", ResetOnSpawn = false, IgnoreGuiInset = true,
		DisplayOrder = 999999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	do
		local parented = false
		if gethui then
			parented = pcall(function() gui.Parent = gethui() end) and gui.Parent ~= nil
		end
		if not parented then
			parented = pcall(function() gui.Parent = SV.CoreGui end) and gui.Parent ~= nil
		end
		if not parented then
			gui.Parent = LP:WaitForChild("PlayerGui")
		end
	end

	local root = mk("Frame", {
		Size = UDim2.fromOffset(W_OPEN, H), Position = UDim2.fromOffset(12, 64),
		BackgroundColor3 = C_BG, BackgroundTransparency = 0.05, BorderSizePixel = 0,
		ClipsDescendants = true, Active = true, ZIndex = 1,
	}, gui)
	mk("UICorner", { CornerRadius = UDim.new(0, 14) }, root)
	mk("UIStroke", { Thickness = 1.2, Color = C_ACC, Transparency = 0.25 }, root)

	local function pressFx(btn)
		local sc = mk("UIScale", { Scale = 1 }, btn)
		btn.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				TS:Create(sc, TI_DOWN, { Scale = 0.86 }):Play()
			end
		end)
		btn.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				TS:Create(sc, TI_UP, { Scale = 1 }):Play()
			end
		end)
	end

	local function mkBtn(text, x, y, w, h, radius)
		local b = mk("TextButton", {
			Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y),
			BackgroundColor3 = C_NEU_BG, TextColor3 = C_TXT, Text = text,
			Font = Enum.Font.GothamBold, TextSize = 10, BorderSizePixel = 0,
			AutoButtonColor = false, ZIndex = 2,
		}, root)
		mk("UICorner", { CornerRadius = UDim.new(0, radius) }, b)
		pressFx(b)
		return b
	end

	local function paint(btn, bg, fg)
		TS:Create(btn, TI_COL, { BackgroundColor3 = bg, TextColor3 = fg }):Play()
	end

	local foldBtn = mkBtn("-", 3, 3, 22, 22, 11)
	foldBtn.TextSize = 14
	foldBtn.TextColor3 = C_ACC
	local cnt = mk("TextLabel", {
		Size = UDim2.fromOffset(50, H), Position = UDim2.fromOffset(30, 0),
		BackgroundTransparency = 1, Text = "0", TextColor3 = Color3.fromRGB(150, 155, 175),
		Font = Enum.Font.GothamBold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2,
	}, root)
	local ncBtn = mkBtn("NC", 82, 4, 38, 20, 10)
	local saveBtn = mkBtn("SAVE", 124, 4, 42, 20, 10)

	local function paintNC()
		if S.nc then
			paint(ncBtn, C_ON_BG, C_ON_TX)
		else
			paint(ncBtn, C_BAD_BG, C_BAD_TX)
		end
	end

	uiCount = function()
		local s = F.fmt(N.total)
		local mn = #muteList
		if mn > 0 then s = s .. " m" .. mn end
		if BAN.safe then s = "S " .. s end
		cnt.Text = s
	end

	local function screenSize()
		local s = gui.AbsoluteSize
		if s.X < 10 then
			local cam = workspace.CurrentCamera
			s = cam and cam.ViewportSize or Vector2.new(800, 600)
		end
		return s
	end

	local curW = W_OPEN
	local tgt = Vector2.new(12, 64)
	local cur = tgt

	local function clampPos(v)
		local s = screenSize()
		local mx = math.max(0, s.X - curW)
		local my = math.max(0, s.Y - H)
		return Vector2.new(math.clamp(v.X, 0, mx), math.clamp(v.Y, 0, my))
	end

	local dragging, dragInput, startPtr, startTgt = false, nil, Vector2.new(), tgt

	local function isPress(i)
		return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
	end

	root.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			dragInput = input
			startPtr = Vector2.new(input.Position.X, input.Position.Y)
			startTgt = tgt
		end
	end)

	conns[#conns + 1] = UIS.InputChanged:Connect(function(input)
		if not dragging then return end
		if input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			tgt = clampPos(startTgt + (p - startPtr))
		end
	end)

	conns[#conns + 1] = UIS.InputEnded:Connect(function(input)
		if dragging and (input == dragInput or isPress(input)) then
			dragging = false
			dragInput = nil
		end
	end)

	conns[#conns + 1] = RS.RenderStepped:Connect(function(dt)
		local d = tgt - cur
		if d.Magnitude < 0.05 then
			if cur ~= tgt then
				cur = tgt
				root.Position = UDim2.fromOffset(floor(cur.X + 0.5), floor(cur.Y + 0.5))
			end
			return
		end
		cur = cur + d * (1 - math.exp(-dt * 22))
		root.Position = UDim2.fromOffset(floor(cur.X + 0.5), floor(cur.Y + 0.5))
	end)

	local isOpen = true
	foldBtn.Activated:Connect(function()
		isOpen = not isOpen
		curW = isOpen and W_OPEN or W_CLOSED
		foldBtn.Text = isOpen and "-" or "+"
		tgt = clampPos(tgt)
		TS:Create(root, TI_FOLD, { Size = UDim2.fromOffset(curW, H) }):Play()
	end)

	local function setNC(on)
		if on then
			if not INST.nc and not IN.nc() then
				notify("NC: hook failed")
				S.nc = false
				paintNC()
				return false
			end
			if not INST.fn then pcall(IN.fn) end
			S.nc = true
		else
			S.nc = false
		end
		paintNC()
		return S.nc
	end

	ncBtn.Activated:Connect(function()
		setNC(not S.nc)
	end)

	saveBtn.Activated:Connect(function()
		local ok, res = saveNow("manual")
		saveBtn.Text = ok and "OK" or "ERR"
		if ok then
			paint(saveBtn, C_ON_BG, C_ON_TX)
			notify(tostring(res):match("[^/]+$") or res)
		else
			paint(saveBtn, C_BAD_BG, C_BAD_TX)
			notify("Save failed: " .. tostring(res))
		end
		task.delay(1.4, function()
			if saveBtn.Parent then
				saveBtn.Text = "SAVE"
				paint(saveBtn, C_NEU_BG, C_TXT)
			end
		end)
	end)

	conns[#conns + 1] = RS.Heartbeat:Connect(function(dt)
		if not alive then return end
		if dt > 3.5 then X.stall = true end
		busy = true
		local budget = (qt - qh) > QCAP / 2 and 0.006 or 0.0025
		local ok, err = pcall(F.process, budget)
		if not ok then noteErr(err) end
		if D.h <= D.t then
			local okd, errd = pcall(D.writeOne)
			if not okd then noteErr(errd) end
		end
		local now = clock()
		if now - X.lastTick >= 1 then
			local ok2, err2 = pcall(F.tick, now)
			if not ok2 then noteErr(err2) end
		end
		busy = false
	end)

	conns[#conns + 1] = SV.Players.PlayerRemoving:Connect(function(p)
		if p == LP then pcall(saveNow, "close") end
	end)

	pcall(function()
		game:BindToClose(function()
			pcall(saveNow, "close")
		end)
	end)

	local function shutdown(quiet)
		if not alive then return end
		if not quiet then pcall(saveNow, "close") end
		alive = false
		S.nc = false
		for i = 1, #conns do
			pcall(conns[i].Disconnect, conns[i])
		end
		for _, c in pairs(attached) do
			if c then pcall(c.Disconnect, c) end
		end
		FS.del(PATH.flag)
		pcall(function() gui:Destroy() end)
		if genv.AluzSpy and genv.AluzSpy.shutdown == shutdown then
			genv.AluzSpy = nil
		end
	end

	genv.AluzSpy = {
		version = VERSION,
		nc = setNC,
		save = function() return saveNow("manual") end,
		dump = function(b) S.dump = b ~= false end,
		shutdown = shutdown,
		stats = F.stats,
		errors = function() return errMap end,
		debug = function()
			local js = F.enc({ stats = F.stats(), errors = errMap, banned = BAN.list, safe = BAN.safe })
			warn("[AluzSpy] " .. tostring(js))
			return js
		end,
	}

	paintNC()
	uiCount()
	notify("Loaded " .. VERSION)
	warn("[AluzSpy] loaded " .. VERSION)

	task.spawn(function()
		touchFlag("boot", 30)
		local function stage(name, fn)
			if BAN.set[name] or not alive then return end
			touchFlag(name, 30)
			local ok, err = pcall(fn)
			if not ok then
				noteErr("boot_" .. name .. ":" .. tostring(err))
				warn("[AluzSpy] stage " .. name .. " failed: " .. tostring(err))
			end
			task.wait(0.12)
		end
		stage("nc", function()
			if IN.nc() then S.nc = true end
		end)
		stage("fn", IN.fn)
		paintNC()
		stage("s2c", IN.s2c)
		stage("sys", IN.sys)
		stage("net", IN.net)
		stage("http", IN.http)
		stage("ls", IN.ls)
		stage("cb", IN.cb)
		paintNC()
		uiCount()
	end)
end, function(e)
	return tostring(e) .. "\n" .. debug.traceback()
end)

if not okUI then
	warn("[AluzSpy] fatal: " .. tostring(errUI))
	pcall(function()
		SV.StarterGui:SetCore("SendNotification", {
			Title = "Aluz Spy", Text = "Fatal: " .. tostring(errUI):sub(1, 120), Duration = 8,
		})
	end)
end
