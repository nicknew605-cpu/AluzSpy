		if identifyexecutor then
			local n, v = identifyexecutor()
			exec = tostring(n) .. (v and (" " .. tostring(v)) or "")
		end
	end)
	local meta = {
		tool = "Aluz Spy", version = VERSION, schema = 3, executor = exec,
		place = game.PlaceId, job = game.JobId, exported = os.date("%Y-%m-%d %H:%M:%S"),
		reason = reason, session_file = SESSION_PATH,
		uptime = r2(clock() - T0), safe_boot = safeBoot, banned = banList,
		hooks = {
			namecall = ncInstalled, namecall_on = S.nc and MOD.nc, direct = fnInstalled and MOD.fn,
			s2c = s2cInstalled and MOD.s2c, callbacks = cbInstalled and MOD.cb, sys = sysInstalled and MOD.sys,
			net = netInstalled and MOD.net, http = httpInstalled and MOD.http, loadstring = lsInstalled and MOD.ls,
		},
		stats = {
			total = total, logged = logged, merged = merged, sampled_out = sampled,
			suppressed = suppressedTotal, bucket_dropped = bucketDrop, queue_dropped = dropQ,
			errors = errCount, remotes = remoteCount, muted_now = #muteList, attached = nAtt,
			callbacks_wrapped = nCb, entries = #recs,
		},
		dump = {
			enabled = S.dump, files = dumpN, pending = dqt - dqh + 1, skipped = dumpSkipped,
			failed = dumpFail, folder = folderOk and DUMP_DIR or "root", list = dumpList,
		},
		last_errors = errMap,
	}
	local head = '{"schema":3,"meta":' .. (enc(meta) or "{}") .. ',"remotes":' .. (enc(remList()) or "[]") .. ',"logs":['
	local lines = {}
	for i = 1, #recs do
		local js = enc(recOut(recs[i]))
		if js then lines[#lines + 1] = js end
	end
	return head .. "\n" .. table.concat(lines, ",\n") .. "\n]}"
end

saveNow = function(reason)
	if not HAS_W then return false, "no writefile" end
	local manual = reason == "manual"
	if not manual then
		local now = clock()
		if now - lastAutoSave < 2.5 then return true, "skip" end
		lastAutoSave = now
	end
	local prev = busy
	busy = true
	local ok, res = pcall(function()
		process(0.05)
		while writeOneDump() do end
		if not manual and not dirtyLog then return "clean" end
		local body = buildJSON(reason)
		writefile(SESSION_PATH, body)
		if manual and type(setclipboard) == "function" and #body < 1500000 then
			pcall(setclipboard, body)
		end
		dirtyLog = false
		lastReason = reason
		return SESSION_PATH
	end)
	busy = prev
	if ok then return true, res end
	noteErr(res)
	return false, tostring(res)
end

local function hookWith(fn, make, useNc)
	if type(fn) ~= "function" or seenFn[fn] or not hookfn then return false end
	seenFn[fn] = true
	local holder = {}
	if clonefunction then
		local okc, c = pcall(clonefunction, fn)
		if okc and type(c) == "function" then holder.old = c end
	end
	local h = make(holder)
	if useNc then h = nc(h) end
	local ok, o = pcall(hookfn, fn, h)
	if not ok then return false end
	if type(o) == "function" then holder.old = o end
	return holder.old ~= nil
end

local function makeFire(holder)
	return function(self, ...)
		if MOD.fn and S.nc and alive and not busy
			and not (lastNcSelf == self and clock() - lastNcT < 0.004) then
			local ok = pcall(capCall, self, "FireServer", ckc(), ...)
			if not ok then fault("fn") end
		end
		return holder.old(self, ...)
	end
end

local function makeInvoke(holder)
	return function(self, ...)
		if MOD.fn and S.nc and alive and not busy
			and not (lastNcSelf == self and clock() - lastNcT < 0.004) then
			local ok, ent = pcall(capCall, self, "InvokeServer", ckc(), ...)
			if ok and ent then
				local r = pack(holder.old(self, ...))
				enqueue({ k = 2, r = ent, v = r })
				return unpack(r, 1, r.n)
			elseif not ok then
				fault("fn")
			end
		end
		return holder.old(self, ...)
	end
end

