handle = function(e, now)
	local k = e.k
	if k == 1 then
		handleCall(e, e.t or now)
	elseif k == 2 then
		handleRet(e)
	elseif k == 3 then
		handleNet(e, e.t or now)
	elseif k == 4 then
		handleSys(e, e.t or now)
	elseif k == 7 then
		handleSrc(e, e.t or now)
	end
end

local function process(budget)
	local t1 = clock()
	local n = 0
	while qh < qt do
		qh = qh + 1
		local idx = qh % QCAP + 1
		local e = q[idx]
		q[idx] = nil
		if e then handle(e, t1) end
		n = n + 1
		if n % 16 == 0 and clock() - t1 > budget then break end
	end
end

