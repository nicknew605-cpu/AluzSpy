wrapCb = function(rf)
	if type(getcallbackvalue) ~= "function" then return end
	local ok, cb = pcall(getcallbackvalue, rf, "OnClientInvoke")
	if not ok or type(cb) ~= "function" then return end
	if cbIsW[cb] or cbWrap[rf] == cb then return end
	local cnt = cbCount[rf] or 0
	if cnt >= 4 then return end
	local w = function(...)
		if MOD.cb and alive and not busy then
			enqueue({ k = 1, d = "S2C", s = rf, m = "OnClientInvoke", a = pack(...), t = clock() })
		end
		return cb(...)
	end
	if pcall(function() rf.OnClientInvoke = w end) then
		cbIsW[w] = true
		cbWrap[rf] = w
		cbCount[rf] = cnt + 1
		nCb = nCb + 1
	end
end

local function tick(now)
	local dt = now - lastTick
	if dt < 0.5 then dt = 0.5 end
	lastTick = now
	local nl = {}
	for i = 1, #act do
		local st = act[i]
		local el = now - st.ws
		if el < 0.5 then el = 0.5 end
		st.ema = st.ema * 0.5 + (st.wc / el) * 0.5
		st.wc = 0
		st.ws = now
		st.win = {}
		st.nsig = 0
		if st.ema > 0.3 or st.mu then
			nl[#nl + 1] = st
		else
			st.act = false
			st.ema = 0
		end
	end
	act = nl
	for i = #muteList, 1, -1 do
		local mu = muteList[i]
		local c = mu.c
		local dc = c - mu.lc
		mu.lc = c
		local pushedNow = floor(c / mu.every) - floor((c - dc) / mu.every)
		local sk = dc - pushedNow
		if sk < 0 then sk = 0 end
		total = total + sk
		suppressedTotal = suppressedTotal + sk
		mu.st.supp = mu.st.supp + sk
		mu.sup = mu.sup + sk
		local rate = dc / dt
		if rate > mu.peak then mu.peak = rate end
		if now >= mu.exp then
			if rate < 15 then
				releaseMute(mu, i, now, rate)
			else
				mu.exp = now + 3
			end
		end
	end
	if flagUntil > 0 and now > flagUntil then
		fileDel(FLAG)
		flagUntil = 0
	end
	if MOD.cb and now - lastRfScan >= 8 then
		lastRfScan = now
		for i = 1, #rfList do
			pcall(wrapCb, rfList[i])
		end
	end
	local okm, mb = pcall(function() return StatsSvc:GetTotalMemoryUsageMb() end)
	if okm and type(mb) == "number" then
		memHist[#memHist + 1] = mb
		if #memHist > 10 then table.remove(memHist, 1) end
		if (mb > MEM_ABS or mb - memHist[1] > MEM_GROW) and now - lastMemSave > 30 then
			lastMemSave = now
			task.defer(saveNow, "memory")
		end
	end
	if stallFlag then
		stallFlag = false
		task.defer(saveNow, "stall")
	end
	uiCount()
end

local function collectRecs()
	local out = {}
	local first = logSeq - LOGCAP + 1
	if first < 1 then first = 1 end
	for s = first, logSeq do
		local r = logs[(s - 1) % LOGCAP + 1]
		if r and r.i == s then out[#out + 1] = r end
	end
	return out
end

local function remList()
	local out = {}
	local function add(reg)
		for _, st in pairs(reg) do
			out[#out + 1] = {
				d = st.dir, r = st.full, m = st.m, calls = st.n + st.supp, logged = st.logged,
				merged = st.merged, sampled = st.smp, suppressed = st.supp, mutes = st.mutes,
				peak = r2(st.peak), ret = st.ret or nil, muted = st.mu and true or nil,
			}
		end
	end
	add(stC)
	add(stS)
	table.sort(out, function(a, b) return a.calls > b.calls end)
	for i = #out, 101, -1 do out[i] = nil end
	return out
end

